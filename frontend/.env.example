# Frontend configuration. Copy to .env.local if you need to change anything.
# Never put secrets here: every VITE_* value is bundled into the public JavaScript.

# Base URL of the backend API. Default "/api" works in development through the Vite proxy
# (vite.config.js forwards /api to http://localhost:4000).
# VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api (development only, not bundled).
# VITE_DEV_API_TARGET=http://localhost:4000
