# Copy to backend/.env and fill in. Never commit .env.

# development | test | production
NODE_ENV=development

# Vite dev server uses 5173, so the API defaults to 4000.
PORT=4000

# REQUIRED. Must point at a REPLICA SET (MongoDB Atlas clusters always are).
# Inventory reservation (Phase 3) uses multi-document transactions, which a
# standalone mongod does not support.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/everest?retryWrites=true&w=majority

# fatal | error | warn | info | debug | trace | silent  (default: info, silent in tests)
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Maximum JSON request body size.
JSON_BODY_LIMIT=100kb

# REQUIRED. Secret for signing access tokens (HS256), at least 32 characters.
# Left empty on purpose: the server refuses to start until you generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out (all existing tokens become invalid).
JWT_SECRET=

# Access-token lifetime: <number><s|m|h|d>. One shift by default; no refresh tokens.
JWT_EXPIRES_IN=8h

# bcrypt cost factor, 4-15 (each +1 doubles hashing time). Must be >= 10 in production.
BCRYPT_ROUNDS=12

# ── Script-only variables (the server does not read these) ────────────────────
# npm run seed:dev — creates admin@, store@, floor@, qc@, buyer@everest.local.
# Shared password for all five, at least 10 characters. No default on purpose.
# Refuses to run when NODE_ENV=production.
# SEED_PASSWORD=

# npm run bootstrap:admin — creates the FIRST admin (works in production).
# Refuses if an active admin exists. Remove the password from the env afterwards.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Approvals (QC inspections, dispatch) are signed with a per-user RSA key that is generated and kept on
# the server. Private keys are stored encrypted (AES-256-GCM) with this key-encryption key. Generate it
# once per environment and keep it in a secret store; never commit it. Losing it means existing private
# keys cannot be used any more (old signatures stay verifiable: public keys are stored in clear).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SIGNING_KEY_ENCRYPTION_KEY=

# RSA modulus for new signing keys: 2048, 3072 (default, required in production) or 4096.
SIGNING_RSA_BITS=3072

# Workers' wages: share of the daily wage paid for a half day, in basis points (5000 = 50%).
HALF_DAY_WAGE_FACTOR_BP=5000

# Days a buyer has to pay an invoice (due date = issue date + this).
PAYMENT_TERMS_DAYS=30
